# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual Environment
venv/
.env
.env.*
# ...but keep the placeholder template reviewable
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Python cache
.pytest_cache/
.mypy_cache/

# Build
build/
dist/
*.egg-info/

media/

# Safety net: runtime media output must never land inside the media_domain
# package. The suite writes to Config.MEDIA_DIR (<repo>/media) and a stray
# rename once dragged those artifacts into the package where they were
# nearly committed.
media_domain/avatars/
media_domain/chat/
media_domain/hls/
media_domain/subs/
media_domain/uploads/

data/

# Build artifacts
webapp-out/
.npm-cache/
.config/
.stream_db.env

# makepkg work directories and the local bare source repository
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/vergoboy-stream/

# Server runtime — never commit
cookies.txt
hls-live/
mediamtx/
app.py.save

# Ad-hoc editor backups
*.bak
*.bak[0-9]*

# pytest / coverage artefacts
.coverage
.coverage.*
.pytest_cache/

# Locally built packages and the API-origin override written by build-arch.sh
packaging/arch/*.pkg.tar.zst
packaging/arch/.api-origin
