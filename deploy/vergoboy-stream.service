[Unit]
Description=vergoboy.ir — Watch Party Stream Player (Flask + Socket.IO)
After=network.target vergoboy-frontend-build.service
Wants=vergoboy-frontend-build.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/stream
Environment="STREAM_ENV=production"
Environment="STREAM_HOST=127.0.0.1"
Environment="STREAM_PORT=8801"
Environment="PATH=/opt/stream/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="STREAM_SITE_URL=https://vergoboy.ir/stream"
Environment="STREAM_LIVEKIT_URL=wss://vergoboy.ir/livekit"
EnvironmentFile=/opt/stream/.stream_db.env

# If your RTMP/HLS layout differs from config.py's defaults, override the
# templates here (otherwise delete these two lines):
# Environment="STREAM_RTMP_PUSH_TEMPLATE=rtmp://vergoboy.ir:1935/live/{key}"
# Environment="STREAM_HLS_PLAYBACK_TEMPLATE=https://vergoboy.ir/hls/{key}.m3u8"

ExecStart=/opt/stream/venv/bin/python3 /opt/stream/app.py
Restart=always
RestartSec=3

# Baseline hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/stream/media /opt/stream/data

[Install]
WantedBy=multi-user.target