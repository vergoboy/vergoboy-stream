{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vergoboy Stream",
  "version": "0.1.0",
  "identifier": "ir.vergoboy.stream",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000/",
    "beforeDevCommand": "NEXT_PUBLIC_BUILD_TARGET=tauri NEXT_PUBLIC_API_ORIGIN=https://vergoboy.ir npm run dev",
    "beforeBuildCommand": "NEXT_PUBLIC_BUILD_TARGET=tauri NEXT_PUBLIC_API_ORIGIN=https://vergoboy.ir npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "تماشای مشترک | vergoboy.ir",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://vergoboy.ir; media-src 'self' https://vergoboy.ir; connect-src 'self' https://vergoboy.ir wss://vergoboy.ir; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
