# Maintainer: vergoboy-stream local build
#
# Builds one *instance* of the desktop client. The instance is read from
# .instance (written by ../build-arch.sh, default "stream"); the two instances
# differ only in the backend their bundled UI talks to, which is baked into the
# static export before makepkg runs. The Rust binary is compiled from the same
# source either way.
_instance="$(cat "${startdir}/.instance" 2>/dev/null || true)"
_instance="${_instance:-stream}"
pkgname="vergoboy-${_instance}"
# The executable name tracks the package, so the two instances can be installed
# side by side (and have distinct window classes / desktop entries).
_pkgbin="$pkgname"
pkgver=0.1.0
pkgrel=1
pkgdesc='Private cinema watch-party desktop client'
arch=('x86_64')
url='https://vergoboy.ir'
license=('LicenseRef-proprietary')
# No -debug split. A Rust binary has no separate debug ELF for makepkg to split
# off, so the generated -debug package carries no symbols and every build prints
#   Error while writing index for '.../usr/bin/vergoboy-stream': No debugging symbols
# The message looks like a build failure but concerns an artifact nobody consumes,
# and it ships a misleadingly named package next to the real one.
options=('!debug')
# ── the player this package owns ─────────────────────────────────────────────
#
# The client does not use whatever mpv the distribution happens to ship. The
# room's sync plugin is an mpv C plugin (`mpv_open_cplugin`, loaded with
# `--script=w2g.so`), and only an mpv built with -Dcplugins=enabled can load it,
# so the player is built inside this same package from the very mpv fork the
# plugin is written against, and installed next to the client. That is the whole
# point of this section: one `pacman -U vergoboy-<instance>-…zst` yields a client
# that can play, with no second package to install and no PATH lookup at runtime.
#
# The source is the w2g-mpv fork — an mpv tree with w2g/ (the plugin, its sync
# crate, the room server, a CLI) added — referenced in place, as a git source
# like the app itself: AGENTS.md forbids vendoring or forking a sibling
# repository's source into this tree, so nothing of it is copied here. The path
# is written by ../build-arch.sh next to .instance/.api-origin; the default below
# is the sibling checkout's conventional location.
_w2g_mpv_root="${startdir}/../../../w2g-mpv"
[ -r "${startdir}/.w2g-mpv-root" ] && _w2g_mpv_root="$(<"${startdir}/.w2g-mpv-root")"

# 'mpv' is here for the *libraries*, not for the binary: this package ships its
# own mpv (built in build() above), and that binary links exactly the set
# the mpv package already guarantees — ffmpeg, libplacebo, libass, GL, the audio
# backends, … Declaring the single distribution package that owns all of them is
# what keeps this list honest and maintainable: namcap resolves each bundled
# library through it and reports them as "implicitly satisfied" (verified),
# instead of demanding ~200 direct entries. It also leaves /usr/bin/mpv on the
# system as the fallback the client uses if the packaged player is ever missing.
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg' 'openssl' 'libayatana-appindicator' 'mpv')
# No 'patchelf'. build() runs `tauri build --no-bundle`, and tauri only calls
# patchelf from its *bundling* step (AppImage/deb rpath fixups: `patchelf
# --set-rpath ...`). Declaring it anyway made makepkg abort on a host that did
# not have it installed, for a tool the build never runs.
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'base-devel' 'curl' 'wget' 'file'
             # Building the player out of the mpv fork below: meson+ninja for mpv
             # itself, cargo for the sync crate, cc for the C plugin.
             'meson' 'ninja')
source=("${pkgname}::git+file://${startdir}/../.."
        "w2g-mpv::git+file://${_w2g_mpv_root}")
sha256sums=('SKIP' 'SKIP')

# Backend origin baked into the static export, written by ../build-arch.sh.
# Defaults to production when absent (e.g. a bare `makepkg` run).
_api_origin_file="${startdir}/.api-origin"
_api_origin='https://vergoboy.ir'
[ -r "${_api_origin_file}" ] && _api_origin="$(<"${_api_origin_file}")"

# The static export in webapp/out carries NEXT_PUBLIC_API_ORIGIN, but Tauri takes
# its CSP from the *cloned* source tree. A local backend has to be allowlisted, so
# patch the clone here rather than committing a developer machine's IP into the
# repository. (Nothing plays media inside the WebView any more: the native player
# reads the file itself, so there is no blob:/MediaSource allowance to add.)
_inject_csp() {
  local conf="$1"
  API_ORIGIN_INJECT="$_api_origin" python3 - "${conf}" <<'EOF' || return 1
import json, os, re, sys

path = sys.argv[1]
origin = os.environ["API_ORIGIN_INJECT"].rstrip("/")
raw = open(path, encoding="utf-8").read()

match = re.search(r'"csp"\s*:\s*"(?:[^"\\]|\\.)*"', raw)
if match is None:
    sys.exit("no csp key found in " + path)
csp = json.loads("{" + match.group(0) + "}")["csp"]

order, directives = [], {}
for part in csp.split(";"):
    fields = part.split()
    if not fields:
        continue
    directives[fields[0]] = [f for f in fields[1:] if f != "'none'"]
    order.append(fields[0])

def allow(directive, *sources):
    if directive not in directives:
        directives[directive] = []
        order.append(directive)
    for source in sources:
        if source not in directives[directive]:
            directives[directive].append(source)

if origin != "https://vergoboy.ir":
    ws = "ws" + origin[4:] if origin.startswith("http://") else None
    for directive in ("connect-src", "media-src", "img-src"):
        allow(directive, origin, *([ws] if ws else []))

patched = "; ".join(" ".join([d] + directives[d]) for d in order)
raw = raw[:match.start()] + '"csp": ' + json.dumps(patched) + raw[match.end():]
open(path, "w", encoding="utf-8").write(raw)
EOF
}

# Tauri derives the WebView's data directory -- and therefore the localStorage
# the client keeps its session in -- from the app identifier. Two packages both
# claiming ir.vergoboy.stream share that one store, so signing in to /stream
# hands the /w2g window a token its own backend rejects (distinct
# STREAM_JWT_SECRET), and the two apps silently log each other out. Every
# non-original instance gets its own identifier; "stream" is left byte-identical
# so the shipped client's existing session storage stays where it is.
_inject_instance() {
  local conf="$1"
  [ "$_instance" = "stream" ] && return 0
  INSTANCE_INJECT="$_instance" python3 - "${conf}" <<'EOF' || return 1
import json, os, re, sys

path = sys.argv[1]
instance = os.environ["INSTANCE_INJECT"]
raw = open(path, encoding="utf-8").read()

patched, count = re.subn(
    r'("identifier"\s*:\s*)"ir\.vergoboy\.[^"]*"',
    lambda m: m.group(1) + json.dumps("ir.vergoboy." + instance),
    raw,
    count=1,
)
if count != 1:
    sys.exit("no identifier key found in " + path)
open(path, "w", encoding="utf-8").write(patched)
EOF
}

build() {
  cd "${srcdir}/${pkgname}/webapp"
  _inject_csp src-tauri/tauri.conf.json || return 1
  _inject_instance src-tauri/tauri.conf.json || return 1
  npm ci
  npx tsc --noEmit
  # Next 16 cannot read its TypeScript child's stdout in makepkg's isolated
  # Git worktree. Use this checkout's freshly built, independently typechecked
  # static export, while Tauri/Rust is still built from the source worktree.
  cp -a "${startdir}/../../webapp/out" ./out
  # Pin the toolchain. Since the rustc 1.99.0 update (Oct 2026) this release build
  # intermittently SIGSEGVs inside rustc itself -- SEGV_MAPERR in hashbrown while
  # MetadataDecodeContext decodes a dependency's optimized_mir during
  # collect_and_partition_mono_items (coredump path: collect_items_rec -> instance_mir
  # -> optimized_mir -> decode). It is not a stack overflow (fault far below the
  # crashing thread's SP; the old RUST_MIN_STACK/ulimit workaround below does not
  # touch it), it needs the full glib/gtk/tauri dep graph, and it has produced no
  # coredump with 1.97.1 (the toolchain that built every pre-Oct-4 package).
  export RUSTUP_TOOLCHAIN=1.97.1
  # 1.97.1 also intermittently GPFs in librustc_driver (kernel: "general protection
  # fault ... in librustc_driver") when the 16-way parallel opt-3 release codegen
  # oversubscribes RAM and starts thrashing swap. Reproduced on kernel log,
  # deterministic-enough that the same crate/toolchain compiles cleanly in
  # isolation (and the full graph at -j2, verified). Cap codegen concurrency well
  # below the memory ceiling; lower to 2 if a host still faults.
  export CARGO_BUILD_JOBS=4
  # Older rustc recursion issues (SIGSEGV in optimized_mir / encode_metadata under
  # deep MIR optimization): spawned codegen workers need RUST_MIN_STACK; the main
  # thread instead takes its stack from RLIMIT_STACK at exec time. Both raised
  # here. Virtual memory only.
  ulimit -s 65536 2>/dev/null || true
  export RUST_MIN_STACK=33554432
  env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
    npm run tauri -- build --no-bundle --config '{"build":{"beforeBuildCommand":""}}'

  # ── the player: mpv fork + sync plugin ────────────────────────────────────
  #
  # Options mirror w2g-mpv/scripts/build-linux.sh's "full" profile (a real
  # desktop player: GL, EGL, X11/Wayland, ALSA/Pulse/PipeWire, Vulkan) plus the
  # two this package needs:
  #   -Dcplugins=enabled   mpv can load the sync plugin at all. The build fails
  #                        outright when the compiler/OS cannot support it, which
  #                        is the outcome we want: shipping a player that silently
  #                        refuses --script=w2g.so is the failure mode this
  #                        package exists to prevent.
  #   -Dlibmpv=false       only the cplayer binary is shipped: libmpv is a second
  #                        copy of the same code that nothing here links.
  #   -Dcaca=disabled      libcaca is a terminal video output no desktop client
  #                        uses. -Dauto_features=auto picks it up wherever it is
  #                        installed, and linking it adds a runtime dependency
  #                        namcap rightly demands and nothing needs.
  # -Dgpl=true and -Dauto_features=auto follow the fork's own build script, so
  # the player built here is the one its tests and the plugin are written for.
  ( cd "${srcdir}/w2g-mpv" &&
    meson setup build/pkg . -Dbuildtype=release -Dgpl=true -Dcplayer=true -Dlibmpv=false \
      -Dcplugins=enabled -Dcaca=disabled -Dauto_features=auto -Dbuild-date=false -Dtests=false &&
    meson compile -C build/pkg )

  # makepkg exports the distro's CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS and Rustflags for
  # the build systems it expects, and Arch's defaults carry -flto=auto and
  # -C debuginfo=2. Those leak into this plugin's build — cargo hands CFLAGS to the
  # cc-rs build scripts (ring compiles its C and asm through them) and RUSTFLAGS to
  # rustc — and the result is broken in a way that only shows up at runtime: ring's
  # objects come out as LTO bitcode, the `cc` link below runs no LTO, and the shared
  # object keeps 47 undefined own symbols, which mpv refuses to load:
  #   [w2g] C plugin error: undefined symbol: ring_core_0_17_14__p384_elem_mul_mont
  #   [w2g] Could not load cplugin script …/w2g.so
  # A/B'd in a scratch PKGBUILD: with these flags 47 undefined symbols, without
  # them 0, and the plugin then loads and follows a real room. So the player is
  # built with what the fork's own scripts/build-w2g.sh implies — the flags its
  # tests run against — rather than with the distribution's optimisation set.
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS RUSTFLAGS RUSTDOCFLAGS LTOFLAGS

  # The plugin: the sync crate (feature `net` = the WebSocket transport it uses to
  # reach w2g-server) linked into a shared object together with the C plugin, and
  # compiled against this same tree's headers — byte for byte the recipe in
  # w2g-mpv/scripts/build-w2g.sh. --offline first for a build host with no network,
  # plain build as the fallback (the crate's dependencies are in ~/.cargo).
  ( cd "${srcdir}/w2g-mpv/w2g/sync" &&
    (cargo build --release --features net --offline 2>/dev/null || cargo build --release --features net) )
  mkdir -p "${srcdir}/w2g-mpv/build"
  cc -O2 -Wall -Wextra -shared -fPIC \
    -I"${srcdir}/w2g-mpv/include" -I"${srcdir}/w2g-mpv/w2g/sync/include" \
    "${srcdir}/w2g-mpv/w2g/plugin/w2g_plugin.c" \
    "${srcdir}/w2g-mpv/w2g/sync/target/release/libw2g_sync.a" \
    -o "${srcdir}/w2g-mpv/build/w2g.so" -lpthread -ldl -lm
}

package() {
  cd "${srcdir}/${pkgname}"
  install -Dm755 "webapp/src-tauri/target/release/vergoboy-stream" \
    "${pkgdir}/usr/bin/${_pkgbin}"
  install -Dm644 "packaging/arch/${_pkgbin}.desktop" \
    "${pkgdir}/usr/share/applications/${_pkgbin}.desktop"
  install -Dm644 "webapp/src-tauri/icons/32x32.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/${_pkgbin}.png"
  install -Dm644 "webapp/src-tauri/icons/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/${_pkgbin}.png"
  install -Dm644 "webapp/src-tauri/icons/128x128@2x.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${_pkgbin}.png"
  # The player, in this package's own directory. The client looks for it at
  # <its own directory>/../lib/<its own name>/ first (src/native_player.rs), so
  # /usr/bin/vergoboy-<instance> finds /usr/lib/vergoboy-<instance>/{mpv,w2g.so}
  # without an environment variable — and the second instance's package, the
  # distro's /usr/bin/mpv and vergoboy-w2g's /usr/bin/w2g.so all stay untouched.
  # Nothing is installed into /usr/bin: pacman refuses two packages owning one
  # path, which is exactly how this package used to depend on a sibling package
  # for its plugin.
  install -Dm755 "${srcdir}/w2g-mpv/build/pkg/mpv" "${pkgdir}/usr/lib/${pkgname}/mpv"
  install -Dm755 "${srcdir}/w2g-mpv/build/w2g.so" "${pkgdir}/usr/lib/${pkgname}/w2g.so"
  # namcap refuses LicenseRef-* identifiers without a license file under
  #   /usr/share/licenses/<pkgname>/
  # ("E: Uncommon license identifiers ... Found 0/1 required license files").
  # Sourced from the clone, so the file only exists once LICENSE is committed.
  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # w2g-mpv components staged by ../build-final.sh into packaging/arch/dist/.
  # Only the w2g package may ship them: pacman refuses two packages owning one
  # path, and /usr/bin/w2g{,.so,-server,-token} is already owned by the installed
  # vergoboy-w2g — a vergoboy-stream carrying them too dies at `pacman -U` with
  # "exists in filesystem (owned by vergoboy-w2g)". Every other instance skips
  # them; its desktop client resolves W2G_PLUGIN as a sibling of its own binary
  # (native_player.rs), so its native player reports unavailable unless
  # W2G_PLUGIN points elsewhere.
  # dist/ is gitignored, so read from ${startdir} (this checkout), exactly like
  # webapp/out above. A missing file is skipped rather than fatal: build-arch.sh
  # alone stages nothing, and a bare makepkg must still build. The loop must
  # never end on a failed test either — package()'s exit status is what makepkg
  # reports as "A failure occurred in package().", with no reason attached.
  if [ "$_instance" = "w2g" ]; then
    local _staged
    for _staged in w2g w2g.so w2g-server w2g-token; do
      if [ -f "${startdir}/dist/${_staged}" ]; then
        install -Dm755 "${startdir}/dist/${_staged}" "${pkgdir}/usr/bin/${_staged}"
      else
        echo "  -> not staged, skipping usr/bin/${_staged} (packaging/arch/dist/${_staged} absent)"
      fi
    done
  else
    echo "  -> instance '$_instance': w2g-mpv binaries ship in vergoboy-w2g only, skipped"
  fi
}
